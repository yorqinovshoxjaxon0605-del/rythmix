<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CardioMate AI — Pediatric Precision Cardiac Console</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Three.js Engine & Controls -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
    <style>
        body { background-color: #02040a; color: #cbd5e1; font-family: system-ui, -apple-system, sans-serif; overflow: hidden; }
        .hud-glass { background: rgba(8, 15, 30, 0.88); backdrop-filter: blur(16px); border: 1px solid rgba(6, 182, 212, 0.25); box-shadow: 0 0 25px rgba(6, 182, 212, 0.12); }
        .mode-btn-active { background: rgba(6, 182, 212, 0.25) !important; border-color: rgba(6, 182, 212, 0.8) !important; color: #38bdf8 !important; box-shadow: 0 0 12px rgba(6, 182, 212, 0.3); }
        .part-tag { font-family: monospace; font-size: 10px; background: rgba(2, 6, 23, 0.85); border: 1px solid rgba(255, 255, 255, 0.2); padding: 2px 6px; border-radius: 4px; color: #e2e8f0; white-space: nowrap; }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: rgba(2, 6, 23, 0.5); }
        ::-webkit-scrollbar-thumb { background: rgba(6, 182, 212, 0.3); border-radius: 2px; }
    </style>
</head>
<body class="h-screen w-screen flex flex-col justify-between p-3 gap-2.5 select-none">

    <!-- TOP NAVIGATION HEADER -->
    <header class="hud-glass rounded-xl px-5 py-2 flex justify-between items-center shrink-0 z-30">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-cyan-500/10 border border-cyan-500/40 flex items-center justify-center text-cyan-400">
                <i class="fa-solid fa-heart-pulse text-lg animate-pulse"></i>
            </div>
            <div>
                <h1 class="font-bold text-white tracking-wider text-sm flex items-center gap-2 font-mono">
                    CARDIOMATE PREDICTOR
                    <span class="text-[9px] bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 px-2 py-0.5 rounded-full">ANATOMICAL 3D CONSOLE</span>
                </h1>
                <p class="text-[10px] text-slate-400">Pediatric Hemodynamic Risk & Precision Electrocardiogram Engine</p>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <div id="status-banner" class="flex items-center gap-2 px-3 py-1 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-semibold">
                <span id="status-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span id="status-text">AI BACKEND: CONNECTED</span>
            </div>
            <div class="text-right text-[10px] font-mono text-slate-400">
                <div>LATENCY: <span class="text-cyan-400 font-bold">18 ms</span></div>
                <div>MODEL: <span class="text-slate-300">OLLAMA-LOCAL</span></div>
            </div>
        </div>
    </header>

    <!-- MAIN CONSOLE GRID -->
    <main class="flex-1 grid grid-cols-12 gap-3 min-h-0 relative">
        <!-- LEFT PANEL: CLINICAL ALIGNMENT & MEDICATIONS -->
        <aside class="col-span-3 hud-glass rounded-xl p-3 flex flex-col justify-between gap-2.5 min-h-0 z-20 overflow-y-auto">
            <div>
                <div class="text-xs font-bold uppercase tracking-wider text-cyan-400 flex justify-between items-center mb-2 border-b border-slate-800 pb-1.5">
                    <span><i class="fa-solid fa-sliders text-cyan-400 mr-1.5"></i> Clinical Alignment</span>
                    <span class="text-[9px] text-slate-500 font-mono">ESC / Pediatric</span>
                </div>

                <div class="space-y-1.5 text-xs">
                    <label class="flex items-center justify-between p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer">
                        <span class="text-slate-300 text-[11px]">Neonatal / Infant Status</span>
                        <input type="checkbox" value="Neonatal Status" class="comorbidity-check accent-cyan-500" checked>
                    </label>
                    <label class="flex items-center justify-between p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer">
                        <span class="text-slate-300 text-[11px]">Congenital Defect Watch</span>
                        <input type="checkbox" value="Congenital Defect Watch" class="comorbidity-check accent-cyan-500" checked>
                    </label>
                    <label class="flex items-center justify-between p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer">
                        <span class="text-slate-300 text-[11px]">Baseline Hypotension</span>
                        <input type="checkbox" value="Baseline Hypotension" class="comorbidity-check accent-cyan-500">
                    </label>
                    <label class="flex items-center justify-between p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer">
                        <span class="text-slate-300 text-[11px]">ST-Segment Shift Analysis</span>
                        <input type="checkbox" value="ST-Shift Watch" class="comorbidity-check accent-cyan-500" checked>
                    </label>
                    <label class="flex items-center justify-between p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer">
                        <span class="text-slate-300 text-[11px]">QTc Interval Watch</span>
                        <input type="checkbox" value="QTc Watch" class="comorbidity-check accent-cyan-500" checked>
                    </label>
                </div>
            </div>
<!-- ACTIVE MEDICATIONS -->
            <div>
                <div class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-2 border-b border-slate-800 pb-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-pills"></i> Active Medications
                </div>
                <div class="grid grid-cols-2 gap-1.5 text-xs">
                    <label class="flex items-center gap-1.5 p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer text-[10px]">
                        <input type="checkbox" value="Epinephrine" class="drug-check accent-amber-500" checked> Epinephrine
                    </label>
                    <label class="flex items-center gap-1.5 p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer text-[10px]">
                        <input type="checkbox" value="Milrinone" class="drug-check accent-amber-500" checked> Milrinone
                    </label>
                    <label class="flex items-center gap-1.5 p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer text-[10px]">
                        <input type="checkbox" value="Amiodarone" class="drug-check accent-amber-500"> Amiodarone
                    </label>
                    <label class="flex items-center gap-1.5 p-1.5 rounded bg-slate-900/60 border border-slate-800 cursor-pointer text-[10px]">
                        <input type="checkbox" value="Dopamine" class="drug-check accent-amber-500"> Dopamine
                    </label>
                </div>
            </div>

            <!-- 12-LEAD TELEMETRY STATUS GRID -->
            <div>
                <div class="text-[10px] font-bold uppercase text-slate-400 mb-1.5 tracking-wider font-mono">12-Lead Telemetry Alignment</div>
                <div class="grid grid-cols-4 gap-1 text-center text-[10px] font-mono">
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">I OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">II OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">III OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">aVR OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">aVL OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">aVF OK</div>
                    <div id="v1-status-badge" class="bg-amber-950/40 border border-amber-500/40 text-amber-400 py-1 rounded">V1 WARN</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">V2 OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">V3 OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">V4 OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">V5 OK</div>
                    <div class="bg-emerald-950/40 border border-emerald-500/40 text-emerald-400 py-1 rounded">V6 OK</div>
                </div>
            </div>
        </aside>

        <!-- CENTER PANEL: 3D HEART & PRECISION WAVEFORM -->
        <section class="col-span-6 hud-glass rounded-xl p-3 flex flex-col justify-between gap-2.5 min-h-0 relative overflow-hidden">
        <!-- 3D VISUAL MODE TOGGLES -->
            <div class="absolute top-4 left-4 z-20 flex items-center gap-2">
                <button id="mode-hologram" class="px-3 py-1 bg-slate-900/90 text-slate-300 border border-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-800 transition shadow">
                    <i class="fa-solid fa-atom text-cyan-400 mr-1"></i> Hologram
                </button>
                <button id="mode-wireframe" class="px-3 py-1 bg-slate-900/90 text-slate-300 border border-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-800 transition shadow">
                    <i class="fa-solid fa-network-wired text-cyan-400 mr-1"></i> Volumetric Mesh
                </button>
                <button id="mode-realistic" class="mode-btn-active px-3 py-1 bg-slate-900/90 text-slate-300 border border-slate-700 rounded-lg text-xs font-semibold hover:bg-slate-800 transition shadow">
                    <i class="fa-solid fa-heart text-red-500 mr-1"></i> Anatomical Organ (Realistic)
                </button>
            </div>

            <!-- TOGGLE ANATOMICAL LABELS BUTTON -->
            <div class="absolute top-4 right-4 z-20">
                <button id="btn-toggle-labels" class="bg-slate-900/90 text-cyan-400 border border-cyan-500/40 px-3 py-1 rounded-lg text-xs font-mono font-bold hover:bg-slate-800 transition shadow">
                    <i class="fa-solid fa-tags mr-1"></i> Toggle Labels: ON
                </button>
            </div>

            <!-- 3D CANVAS CONTAINER WITH CALLOUT LABELS OVERLAY -->
            <div id="heart-3d-container" class="w-full flex-1 rounded-xl bg-slate-950 flex items-center justify-center relative overflow-hidden cursor-grab active:cursor-grabbing min-h-[300px]">

                <!-- ANATOMICAL CALLOUT LABELS (MATCHING REFERENCE IMAGE) -->
                <div id="labels-overlay" class="absolute inset-0 pointer-events-none z-10 font-mono text-[10px]">
                    <div class="part-tag absolute top-[12%] left-[18%]">Brachiocephalic artery ──┐</div>
                    <div class="part-tag absolute top-[11%] right-[22%]">┌── Left Carotid</div>
                    <div class="part-tag absolute top-[17%] right-[18%]">┌── Left Subclavian</div>
                    <div class="part-tag absolute top-[25%] left-[15%]">Superior Vena Cava ──┐</div>
                    <div class="part-tag absolute top-[26%] right-[20%]">┌── Aortic Arch</div>
                    <div class="part-tag absolute top-[33%] right-[15%]">┌── Pulmonary Trunk</div>
                    <div class="part-tag absolute top-[34%] left-[12%]">Right Pulmonary Artery ──┐</div>
                    <div class="part-tag absolute top-[41%] right-[14%]">┌── Left Pulmonary Artery</div>
                    <div class="part-tag absolute top-[43%] left-[18%]">Right Atrium ──┐</div>
                    <div class="part-tag absolute top-[49%] right-[18%]">┌── Left Atrium</div>
                    <div class="part-tag absolute top-[52%] left-[12%]">Inferior Vena Cava ──┐</div>
                    <div class="part-tag absolute top-[56%] right-[12%]">┌── Pulmonary Veins</div>
                    <div class="part-tag absolute top-[62%] left-[10%]">Right Coronary Artery ──┐</div>
                    <div class="part-tag absolute top-[64%] right-[10%]">┌── Left Anterior Descending</div>
                    <div class="part-tag absolute top-[72%] left-[14%]">Right Ventricle ──┐</div>
                    <div class="part-tag absolute top-[76%] right-[14%]">┌── Left Ventricle</div>
                    <div class="part-tag absolute bottom-[8%] left-[42%]">▲ Apex</div>
                </div>
            </div>
<!-- PRECISION ECG WAVEFORM CONTAINER -->
            <div class="h-32 rounded-xl bg-slate-950/90 border border-cyan-500/30 p-2.5 flex flex-col justify-between shrink-0">
                <div class="flex justify-between items-center text-xs text-slate-400 px-1">
                    <span class="font-mono text-cyan-400 flex items-center gap-1.5 text-[11px]">
                        <i class="fa-solid fa-chart-line"></i> LIVE TELEMETRY WAVEFORM (Lead II P-Q-R-S-T)
                    </span>
                    <span class="font-mono text-[10px] text-slate-400">500 Hz | 25mm/s</span>
                </div>

                <div class="w-full flex-1 relative my-1">
                    <canvas id="ecg-canvas" class="absolute inset-0 w-full h-full bg-slate-950 rounded border border-slate-900/80"></canvas>
                </div>

                <div class="flex justify-between items-center pt-1 border-t border-slate-900/60">
                    <span class="text-[10px] text-slate-500 font-mono">PATHWAY: <strong id="st-status" class="text-emerald-400">Stable Baseline</strong></span>
                    <button id="btn-trigger-anomaly" class="bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/40 px-3 py-0.5 rounded text-xs font-semibold transition">
                        <i class="fa-solid fa-bolt mr-1"></i> Simulate Cardiac Anomaly
                    </button>
                </div>
            </div>
        </section>

        <!-- RIGHT PANEL: LIVE HEMODYNAMICS & AI HORIZON -->
        <aside class="col-span-3 hud-glass rounded-xl p-3 flex flex-col justify-between gap-2.5 min-h-0 z-20">
            <!-- LIVE HEMODYNAMICS -->
            <div>
                <div class="text-xs font-bold uppercase tracking-wider text-cyan-400 mb-2 border-b border-slate-800 pb-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-heart-pulse"></i> Live Hemodynamics
                </div>
                <div class="grid grid-cols-2 gap-2 text-center">
                    <div class="bg-slate-900/80 border border-slate-800 p-2 rounded-lg">
                        <div class="text-[10px] text-slate-400 font-mono uppercase"><i class="fa-solid fa-heart text-red-500 mr-1"></i> HR (BPM)</div>
                        <div id="val-hr" class="text-xl font-bold font-mono text-white">138</div>
                        <div class="text-[9px] text-emerald-400">Pediatric Normal</div>
                    </div>
                    <div class="bg-slate-900/80 border border-slate-800 p-2 rounded-lg">
                        <div class="text-[10px] text-slate-400 font-mono uppercase"><i class="fa-solid fa-gauge-high text-cyan-400 mr-1"></i> BP (mmHg)</div>
                        <div id="val-bp" class="text-xl font-bold font-mono text-white">85/52</div>
                        <div class="text-[9px] text-slate-400">MAP: <span id="val-map" class="text-cyan-400 font-bold">63</span> mmHg</div>
                    </div>
                    <div class="bg-slate-900/80 border border-slate-800 p-2 rounded-lg">
                        <div class="text-[10px] text-slate-400 font-mono uppercase"><i class="fa-solid fa-chart-pie text-amber-400 mr-1"></i> % LVEF</div>
                        <div class="text-xl font-bold font-mono text-amber-400">58%</div>
                        <div class="text-[9px] text-slate-400">Systolic Function</div>
                    </div>
                    <div class="bg-slate-900/80 border border-slate-800 p-2 rounded-lg">
                        <div class="text-[10px] text-slate-400 font-mono uppercase"><i class="fa-solid fa-lungs text-blue-400 mr-1"></i> SpO2</div>
                        <div class="text-xl font-bold font-mono text-cyan-300">98%</div>
                        <div class="text-[9px] text-slate-400">Saturation</div>
                    </div>
                </div>
            </div>
<!-- MULTI-HORIZON AI RISK -->
            <div>
                <div class="text-xs font-bold uppercase tracking-wider text-cyan-400 mb-2 border-b border-slate-800 pb-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-brain"></i> Multi-Horizon AI Horizon
                </div>
                <div class="space-y-2 text-xs">
                    <div class="bg-slate-900/90 border border-slate-800 p-2 rounded-lg">
                        <div class="flex justify-between items-center text-[11px] mb-1">
                            <span class="text-slate-300 font-semibold">0-15 Min Imminent Risk</span>
                            <span id="risk-val-15" class="font-mono font-bold text-emerald-400">0.12 (LOW)</span>
                        </div>
                        <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden">
                            <div id="risk-bar-15" class="bg-emerald-500 h-full w-[12%] transition-all duration-500"></div>
                        </div>
                    </div>

                    <div class="bg-slate-900/90 border border-slate-800 p-2 rounded-lg">
                        <div class="flex justify-between items-center text-[11px] mb-1">
                            <span class="text-slate-300 font-semibold">1.5-2 Hr Decompensation</span>
                            <span id="risk-val-2h" class="font-mono font-bold text-cyan-400">0.28 (STABLE)</span>
                        </div>
                        <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden">
                            <div id="risk-bar-2h" class="bg-cyan-500 h-full w-[28%] transition-all duration-500"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- AI RECOMMENDATION BOX -->
            <div id="recommendation-box" class="bg-emerald-950/30 border border-emerald-500/30 p-2.5 rounded-lg text-xs space-y-1.5">
                <div class="font-bold text-emerald-400 flex items-center gap-1.5 text-[11px]">
                    <i class="fa-solid fa-shield-halved"></i> Clinical Recommendation
                </div>
                <p id="recommendation-text" class="text-slate-300 text-[10px] leading-relaxed">
                    Hemodynamics stable. Continue baseline volatile anesthetic maintenance and telemetry monitoring.
                </p>
            </div>

            <!-- SYSTEM STATUS -->
            <div class="flex justify-between items-center text-[11px] font-mono border-t border-slate-800 pt-2 text-slate-400">
                <div id="system-status-text" class="text-emerald-400 font-bold flex items-center gap-1">
                    <i class="fa-solid fa-circle-check"></i> SYSTEM STABLE
                </div>
                <div>0 ALERTS</div>
            </div>
        </aside>
    </main>

    <!-- THREE.JS HIGH-REALISM ORGAN ENGINE & PRECISION ECG LOGIC -->
    <script>
        // 1. THREE.JS SCENE SETUP
        const container = document.getElementById('heart-3d-container');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(38, container.clientWidth / container.clientHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });

        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.1;
        container.appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.05;
        camera.position.set(0, 0, 4.8);

        // Studio Lighting Pipeline
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);
const keyLight = new THREE.DirectionalLight(0xfff5eb, 2.5);
        keyLight.position.set(5, 7, 5);
        scene.add(keyLight);

        const fillLight = new THREE.DirectionalLight(0x2a0808, 1.4);
        fillLight.position.set(-5, -4, -3);
        scene.add(fillLight);

        const heartGroup = new THREE.Group();
        scene.add(heartGroup);

        // Materials
        const hologramMat = new THREE.MeshPhysicalMaterial({
            color: 0x06b6d4, emissive: 0x0284c7, emissiveIntensity: 1.2,
            roughness: 0.1, transmission: 0.8, transparent: true, opacity: 0.75
        });

        let currentVisualMode = 'realistic';
        let loadedModel = null;

        // LOAD GLTF MODEL DIRECTLY FROM LOCAL PROJECT DIR (heart.glb) OR CDN
        const gltfLoader = new THREE.GLTFLoader();

        function loadHeartModel(url) {
            gltfLoader.load(url, (gltf) => {
                if (loadedModel) heartGroup.remove(loadedModel);
                loadedModel = gltf.scene;

                const box = new THREE.Box3().setFromObject(loadedModel);
                const center = box.getCenter(new THREE.Vector3());
                const size = box.getSize(new THREE.Vector3());
                const scale = 2.6 / Math.max(size.x, size.y, size.z);

                loadedModel.position.sub(center.multiplyScalar(scale));
                loadedModel.scale.set(scale, scale, scale);
                heartGroup.add(loadedModel);
            }, undefined, (err) => {
                // Fallback attempt to secondary CDN asset if local missing
                if (url !== 'heart.glb') loadHeartModel('heart.glb');
            });
        }

        // Try local asset 'heart.glb' first
        loadHeartModel('https://cdn.jsdelivr.net/gh/yihalem123/Human-Organ3D@main/models/heart.glb');

        // Toggle Labels
        let labelsVisible = true;
        document.getElementById('btn-toggle-labels').addEventListener('click', () => {
            labelsVisible = !labelsVisible;
            const overlay = document.getElementById('labels-overlay');
            const btn = document.getElementById('btn-toggle-labels');
            if (labelsVisible) {
                overlay.style.display = 'block';
                btn.innerHTML = '<i class="fa-solid fa-tags mr-1"></i> Toggle Labels: ON';
            } else {
                overlay.style.display = 'none';
                btn.innerHTML = '<i class="fa-solid fa-tags mr-1"></i> Toggle Labels: OFF';
            }
        });

        function setMode(mode) {
            currentVisualMode = mode;
            document.querySelectorAll('[id^="mode-"]').forEach(btn => btn.classList.remove('mode-btn-active'));
            document.getElementById(`mode-${mode}`).classList.add('mode-btn-active');

            if (loadedModel) {
                loadedModel.traverse((child) => {
                    if (child.isMesh) {
                        if (mode === 'wireframe') {
                            child.material = hologramMat;
                            child.material.wireframe = true;
                        } else if (mode === 'hologram') {
                            child.material = hologramMat;
                            child.material.wireframe = false;
                        } else if (mode === 'realistic') {
                            child.material.wireframe = false;
                        }
                    }
                });
            }
        }

        document.getElementById('mode-hologram').addEventListener('click', () => setMode('hologram'));
        document.getElementById('mode-wireframe').addEventListener('click', () => setMode('wireframe'));
        document.getElementById('mode-realistic').addEventListener('click', () => setMode('realistic'));

        // 3D Systolic Animation Loop
        let clock = new THREE.Clock();
        function animate3D() {
            requestAnimationFrame(animate3D);
            controls.update();
            const t = clock.getElapsedTime();
        const beat = Math.sin(t * 4.2) * 0.035;
            const s = 1.0 + Math.max(0, beat);
            heartGroup.scale.set(s, s, s);

            heartGroup.rotation.y = t * 0.12;
            renderer.render(scene, camera);
        }
        animate3D();

        function handleResize() {
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        }
        window.addEventListener('resize', handleResize);


        // 2. MATHEMATICALLY ACCURATE P-Q-R-S-T ECG ENGINE
        const ecgCanvas = document.getElementById('ecg-canvas');
        const ecgCtx = ecgCanvas.getContext('2d');
        let ecgTime = 0;
        let isAnomalyActive = false;

        function resizeECGCanvas() {
            const rect = ecgCanvas.parentElement.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
                if (ecgCanvas.width !== rect.width || ecgCanvas.height !== rect.height) {
                    ecgCanvas.width = rect.width;
                    ecgCanvas.height = rect.height;
                }
            }
        }

        function calculatePQRSTVoltage(t, isAnomaly) {
            const beatPeriod = 0.44; // ~138 BPM
            const phase = (t % beatPeriod) / beatPeriod;

            let v = 0;
            if (phase > 0.08 && phase < 0.18) v += 0.15 * Math.sin(((phase - 0.08) / 0.10) * Math.PI); // P Wave
            else if (phase >= 0.22 && phase < 0.25) v -= 0.12 * Math.sin(((phase - 0.22) / 0.03) * Math.PI); // Q Wave
            else if (phase >= 0.25 && phase < 0.29) v += 1.0 * Math.sin(((phase - 0.25) / 0.04) * Math.PI); // R Spike
            else if (phase >= 0.29 && phase < 0.33) v -= 0.25 * Math.sin(((phase - 0.29) / 0.04) * Math.PI); // S Wave
            else if (phase >= 0.33 && phase < 0.60) {
                const tPhase = (phase - 0.33) / 0.27;
                v += 0.22 * Math.sin(tPhase * Math.PI) + (isAnomaly ? 0.38 * Math.sin(tPhase * Math.PI * 0.8) : 0); // T Wave + ST Shift
            }
            return v;
        }

        function drawPrecisionECG() {
            requestAnimationFrame(drawPrecisionECG);
            resizeECGCanvas();

            const width = ecgCanvas.width;
            const height = ecgCanvas.height;

            if (width === 0 || height === 0) return;

            ecgCtx.fillStyle = '#020617';
            ecgCtx.fillRect(0, 0, width, height);

            ecgCtx.strokeStyle = 'rgba(6, 182, 212, 0.12)';
            ecgCtx.lineWidth = 1;
            for (let x = 0; x < width; x += 15) {
                ecgCtx.beginPath(); ecgCtx.moveTo(x, 0); ecgCtx.lineTo(x, height); ecgCtx.stroke();
            }
            for (let y = 0; y < height; y += 15) {
                ecgCtx.beginPath(); ecgCtx.moveTo(0, y); ecgCtx.lineTo(width, y); ecgCtx.stroke();
            }

            ecgCtx.beginPath();
            ecgCtx.strokeStyle = isAnomalyActive ? '#ef4444' : '#06b6d4';
            ecgCtx.lineWidth = 2;

            const centerY = height / 2;
            const amplitudeScale = height * 0.35;

            for (let pixelX = 0; pixelX < width; pixelX++) {
                const sampleTime = ecgTime + (pixelX * 0.003);
                const voltage = calculatePQRSTVoltage(sampleTime, isAnomalyActive);
                const pixelY = centerY - (voltage * amplitudeScale);

                if (pixelX === 0) ecgCtx.moveTo(pixelX, pixelY);
                else ecgCtx.lineTo(pixelX, pixelY);
            }
            ecgCtx.stroke();
            ecgTime += 0.009;
        }
        drawPrecisionECG();
// Anomaly Event Trigger
        document.getElementById('btn-trigger-anomaly').addEventListener('click', () => {
            isAnomalyActive = !isAnomalyActive;
            const btn = document.getElementById('btn-trigger-anomaly');
            const stLabel = document.getElementById('st-status');
            const v1Badge = document.getElementById('v1-status-badge');
            const systemStatus = document.getElementById('system-status-text');

            if (isAnomalyActive) {
                btn.className = "bg-red-600 text-white font-bold px-3 py-0.5 rounded text-xs transition shadow-[0_0_15px_rgba(239,68,68,0.5)]";
                btn.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i> Anomaly Active';
                stLabel.innerText = 'ST-Elevation Shift (V1-V3)';
                stLabel.className = 'text-red-400 font-bold animate-pulse';
                v1Badge.className = 'bg-red-950/60 border border-red-500/60 text-red-400 py-1 rounded animate-pulse font-bold';
                v1Badge.innerText = 'V1 CRIT';
                systemStatus.className = 'text-red-400 font-bold flex items-center gap-1 animate-pulse';
                systemStatus.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> CRITICAL ALERT';
                document.getElementById('val-hr').innerText = '164';
                document.getElementById('val-bp').innerText = '72/40';
                document.getElementById('val-map').innerText = '50';
            } else {
                btn.className = "bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/40 px-3 py-0.5 rounded text-xs font-semibold transition";
                btn.innerHTML = '<i class="fa-solid fa-bolt mr-1"></i> Simulate Cardiac Anomaly';
                stLabel.innerText = 'Stable Baseline';
                stLabel.className = 'text-emerald-400 font-bold';
                v1Badge.className = 'bg-amber-950/40 border border-amber-500/40 text-amber-400 py-1 rounded';
                v1Badge.innerText = 'V1 WARN';
                systemStatus.className = 'text-emerald-400 font-bold flex items-center gap-1';
                systemStatus.innerHTML = '<i class="fa-solid fa-circle-check"></i> SYSTEM STABLE';
                document.getElementById('val-hr').innerText = '138';
                document.getElementById('val-bp').innerText = '85/52';
                document.getElementById('val-map').innerText = '63';
            }
        });


        // 3. FASTAPI BACKEND OLLAMA QUERY LOOP
        async function queryAIBackend() {
            const selectedDrugs = Array.from(document.querySelectorAll('.drug-check:checked')).map(c => c.value);
            const selectedComorbidities = Array.from(document.querySelectorAll('.comorbidity-check:checked')).map(c => c.value);

            const ecgMatrix = [];
            for (let lead = 0; lead < 12; lead++) {
                ecgMatrix.push(new Array(5000).fill(0).map(() => isAnomalyActive ? (Math.random() * 2.5 - 1.2) : (Math.random() * 0.4 - 0.2)));
            }

            try {
                const response = await fetch('http://127.0.0.1:8000/predict', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ecg_signal: ecgMatrix,
                        drugs: selectedDrugs,
                        comorbidities: selectedComorbidities
                    })
                });
                const result = await response.json();

                const score15 = result.risk_score || (isAnomalyActive ? 0.88 : 0.12);
                const score2h = isAnomalyActive ? 0.74 : 0.28;
            document.getElementById('risk-bar-15').style.width = Math.round(score15 * 100) + '%';
                document.getElementById('risk-val-15').innerText = score15 + (score15 > 0.7 ? ' (HIGH)' : ' (LOW)');
                document.getElementById('risk-bar-15').className = score15 > 0.7 ? 'bg-red-500 h-full transition-all duration-500' : 'bg-emerald-500 h-full transition-all duration-500';

                document.getElementById('risk-bar-2h').style.width = Math.round(score2h * 100) + '%';
                document.getElementById('risk-val-2h').innerText = score2h + (score2h > 0.7 ? ' (WARNING)' : ' (STABLE)');

                document.getElementById('recommendation-text').innerText = result.ai_recommendation;

                document.getElementById('status-banner').className = "flex items-center gap-2 px-3 py-1 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-semibold";
                document.getElementById('status-text').innerText = "AI BACKEND: CONNECTED";
            } catch (err) {
                document.getElementById('status-banner').className = "flex items-center gap-2 px-3 py-1 rounded-lg border border-red-500/30 bg-red-500/10 text-red-400 text-xs font-semibold";
                document.getElementById('status-text').innerText = "AI BACKEND: DISCONNECTED";
            }
        }

        setInterval(queryAIBackend, 3000);
        queryAIBackend();
    </script>
</body>
</html>
